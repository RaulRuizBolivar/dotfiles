{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# Runs once on Linux after chezmoi apply
# Idempotent - safe to re-run

set -euo pipefail

echo "==> Linux post-install"

# Ensure user dirs
mkdir -p ~/.config ~/.local/bin ~/.scripts ~/.cache

# Make all scripts executable
chmod +x ~/.scripts/* 2>/dev/null || true

echo "==> Done. Reload your shell: source ~/.zshrc"
{{- end -}}
