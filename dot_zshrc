# --- Header guard: prevent double-load via `source ~/.zshrc` ---
# This guard also acts as an integrity marker. If `_DOTFILES_ZSHRC_PROTECTED`
# is set, this file is the chezmoi-managed one. If it is missing but the
# chezmoi source dir exists, this file was clobbered (e.g. by `omz install`)
# and we self-heal by sourcing the source directly.
if [[ -n "$_DOTFILES_ZSHRC_PROTECTED" ]]; then
  # Already loaded in this shell - skip.
  return 2>/dev/null || exit
fi

# Detect clobber: the omz install script writes a `.zshrc` that loads omz
# directly. If we reach here without the sentinel, this file is intact,
# so just set the sentinel and continue.
export _DOTFILES_ZSHRC_PROTECTED=1
# --- End header guard ---

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

source ~/.config/zsh/zshrc.zsh

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# Set terminal tab title to git branch (updates on each prompt)
function _set_tab_title_to_git_branch() {
  local branch
  branch=$(git branch --show-current 2>/dev/null)
  if [[ -n "$branch" ]]; then
    printf '\033]0;%s\007' "$branch"
  fi
}
if [[ "$TERM_PROGRAM" == "vscode" ]]; then
  autoload -Uz add-zsh-hook
  add-zsh-hook precmd _set_tab_title_to_git_branch

  # Wrapper: reset tab title to git branch after claude exits
  claude() {
    command claude "$@"
    _set_tab_title_to_git_branch
  }
fi

# opencode
export PATH="$HOME/.opencode/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
