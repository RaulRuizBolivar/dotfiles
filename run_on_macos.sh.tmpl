#!/usr/bin/env bash
# Runs once on macOS after chezmoi apply
# Idempotent - safe to re-run

set -euo pipefail

echo "==> macOS post-install"

# Ensure user dirs
mkdir -p ~/.config ~/.local/bin ~/.scripts ~/.cache

# Install command line tools if not present
if ! xcode-select -p &>/dev/null; then
  echo "  !  Install Command Line Tools: xcode-select --install"
fi

# Recommend Homebrew
if ! command -v brew &>/dev/null; then
  echo "  !  Install Homebrew: https://brew.sh"
fi

echo "==> Done. Reload your shell: source ~/.zshrc"
