# ============================================================
#  ~/.zshrc - managed by chezmoi, OS-aware
#  Source: https://github.com/RaulRuizBolivar/dotfiles
# ============================================================

# Powerlevel10k instant prompt (must be near the top)
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git pj nvm sudo zsh-interactive-cd fzf)
source $ZSH/oh-my-zsh.sh

# Modular config dir (also managed by chezmoi)
ZSH_DOTFILES="$HOME/.zsh"

# Load order matters: exports -> aliases -> prompt -> tools -> os
for f in \
  $ZSH_DOTFILES/exports.zsh \
  $ZSH_DOTFILES/aliases.zsh \
  $ZSH_DOTFILES/prompt.zsh \
  $ZSH_DOTFILES/tools.zsh \
  $ZSH_DOTFILES/os_{{ .chezmoi.os }}.zsh \
  $ZSH_DOTFILES/local.zsh; do
  [[ -f "$f" ]] && source "$f"
done

# p10k config (generated)
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
