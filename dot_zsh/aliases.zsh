# Common aliases

# Editor
alias n="nvim"
alias v="nvim"
alias zrc="nvim ~/.zshrc"
alias refresh="source ~/.zshrc"

# Navigation
alias ll="ls -lh"
alias la="ls -lha"
alias ..="cd .."
alias ...="cd ../.."

# Git
alias g="git"
alias gst="git status"
alias gd="git diff"
alias gc="git commit"
alias gp="git push"
alias gl="git log --oneline --graph --decorate -20"
alias lgit="lazygit"

# Dev
alias dev="npm run start:dev"
alias ngc="ng generate component"

# Tools
alias lg="lazygit"
alias lf="lf"
alias r="ranger"
alias zll="zellij a work"
